{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Held-out custody manifest (metadata only)",
  "description": "Companion to src/core/contracts.ts HeldoutManifestSchema. Path uniqueness and custody/content checks are additionally enforced by the importer. No held-out contents belong in the product repo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "custodian", "sealedAt", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "custodian": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "modelFamily"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "modelFamily": { "type": "string", "minLength": 1 } }
    },
    "sealedAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "bytes", "sha256"],
        "properties": {
          "kind": { "enum": ["task_file", "carry_sealed"] },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^:]+$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
